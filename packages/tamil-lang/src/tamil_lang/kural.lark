// Kural — the .tamil kernel grammar (RFC-0002 §3, D11). The FULL base-6 primitives.
// Ezhuthu (the grammar-as-tokenizer, §4.5) is Lark's contextual lexer over THESE terminals — source
// symbols lower directly to kernel tokens, no BPE. One grammar, three uses (parse · lex · AST).
//
// The base-4 (universal, Turing-complete) + governed-AI-2 (the moat), each a statement form:
//   goal            — the telos the runtime energizes            (goal "...")
//   capability-call — the universal "do" (faculties lower here)  (call f(x))
//   governance-check— the deny-by-default Aram gate              (govern rank >= 2)
//   control-flow    — sequence / branch / loop                   (if a > b {..} else {..} · for x in xs {..})
//   compose/bind    — how one node's output feeds another        (bind y = call f(x))
//   memory-ref      — read/write the memory graph (Ninaivu)      (remember k = v · recall(k))

start: (goal | fndef | import_decl)+

goal: "goal" STRING block

// fn — a user-defined function (G1, plan-local D69). NOT a 7th kernel node: calling it is a
// plain `call` (capability-call), lowered exactly like any other capability. `params` (G8)
// widens G1's 0-arg-only scope -- register-only in v0 (see FnDef's own docstring).
fndef: "fn" NAME "(" [NAME ("," NAME)*] ")" block

// import — multi-file programs (G7, plan-local D69). NOT a Statement, NOT a new kernel node:
// resolution is entirely a closed-tree, pre-codegen concern (Zig's `@import` + Go's whole-
// program-DAG precedent). `path` is resolved relative to the IMPORTING file's own directory.
import_decl: "import" NAME "=" STRING

block: "{" statement* "}"

?statement: call             // capability-call
          | qualified_call   // capability-call into an imported file (G7)
          | ffi_call          // capability-call, kind=ffi_bridge (D10, T3.1)
          | govern           // governance-check
          | bind             // compose/bind
          | cached_bind      // compose/bind, memoized by Mugavari ID (T8.17)
          | remember         // memory-ref (write)
          | branch           // control-flow (branch)
          | loop             // control-flow (loop)
          | return_stmt      // control-flow (return), additive `form` (G1) — exits the enclosing fn
          | push_stmt        // memory-ref, additive `op` (G5) — appends to a list, real runtime growth
          | map_set_stmt     // memory-ref, additive `op` (G5) — push's sibling for a map
          | match_stmt       // control-flow, additive `form` (G9) — pattern matching over records/Results
          | parallel_stmt    // control-flow, additive `form` (G10) — structural parallelism, no spawn keyword
          | derive_stmt      // memory-ref, additive `op` (G11) — compile-time reactive derived state

call: "call" NAME "(" [value ("," value)*] ")"
// a call into an imported file's fn (G7) -- `Call.name` already accepts any `str`, so this
// lowers to the SAME `Call` node with a dotted `"alias.fn"` name, zero AST change needed.
qualified_call: "call" NAME "." NAME "(" [value ("," value)*] ")"
// ffi_bridge is a capability-call kind, not a new kernel primitive (D10) — Python only this pass (T3.1).
// The parser only declares the call; governed execution (rank/scope/sandboxing) lives in the closed tree.
ffi_call: "ffi" "python" NAME "(" [value ("," value)*] ")"
// fallible is a capability-call kind (T8.16), not a new kernel primitive: the target returns a
// packed (tag, value) result (T8.15's convention) instead of a plain scalar — Result-as-value
// error handling, not real stack-unwinding.
fallible_call: "fallible" NAME "(" [value ("," value)*] ")"
govern: "govern" NAME OP value
bind: "bind" NAME "=" (call | qualified_call | ffi_call | fallible_call | verified_field)
// verified field access (G3) -- a Bind-only shape, not a plain value (same "not a value" shape
// as fallible_call/ffi_call): recomputes + compares a record's XOR checksum at read time,
// packing (match, value) the same way T8.15/T8.16's fallible convention already does.
verified_field: "verified" NAME "." NAME
// cached bind -- memoized by Mugavari ID (T8.17). v0 scope: only a plain `call` may be cached;
// composing with ffi_call/fallible_call needs its own real storage-shape design, not attempted.
cached_bind: "cached" "bind" NAME "=" call
remember: "remember" NAME "=" value
branch: "if" value OP value block ["else" block]
loop: "for" NAME "in" value block
return_stmt: "return" value
// list/map runtime growth (G5, plan-local D69) -- `memory-ref`'s additive `push`/`map-set` op,
// not a new kernel node. `value`/keys are literal-only in v0 (same "literal, not computed"
// boundary array_literal's own index already draws).
push_stmt: "push" NAME value
map_set_stmt: "mapset" NAME value value
// match (G9, plan-local D69) -- `control-flow`'s additive `form`, not a new kernel node. Two
// v0 shapes: Result matching (`ok(v)`/`err(e)` over a fallible/verified Bind's packed tag,
// research: Erlang/Elixir's tagged-tuple matching maps directly onto this convention) and
// literal matching (an integer literal over a bound int name, `_` REQUIRED for totality).
// An optional `if <cond>` guard reuses `branch`'s own `value OP value` shape verbatim.
match_stmt: "match" NAME "{" match_arm+ "}"
match_arm: match_pattern ["if" value OP value] "=>" block
?match_pattern: "ok" "(" NAME ")" -> ok_pattern
              | "err" "(" NAME ")" -> err_pattern
              | NUMBER -> literal_pattern
              | "_" -> wildcard_pattern
// parallel (G10, plan-local D69) -- `control-flow`'s additive `form`, not a new kernel node.
// Each top-level statement in the block is its own unit of concurrency -- NO `spawn` keyword,
// the compiler (not the programmer) decides these N statements run concurrently. v0 scope:
// every branch must be self-contained (no name shared with the outer scope or a sibling
// branch); real OS-thread fork-join at execution time (Windows CreateThread, Linux
// pthread_create), not simulated.
parallel_stmt: "parallel" "{" statement* "}"
// derive (G11, plan-local D69) -- `memory-ref`'s additive `op`, not a new kernel node.
// Svelte-style COMPILE-TIME reactivity: lowers to a Remember(Compute(...)) at its own
// declaration point PLUS a re-emitted copy after every later write to a dependency
// (`_lower_derives`, kollan/__init__.py). v0 scope: exactly one operator, both operands
// each an already-bound name or an integer literal -- no nested sub-expressions.
derive_stmt: "derive" NAME "=" value ARITH_OP value
ARITH_OP: "+" | "-" | "*" | "/"

?value: atom | recall | range_expr | array_literal | index_expr | record_literal | field_expr
      | is_ok_expr | payload_expr | list_literal | map_literal | cycles_expr
recall: "recall" "(" NAME ")"   // memory-ref (read)
// range(start, stop) — additive to Loop.iterable's value space (D50/D60: not a new kernel
// node kind, `control-flow (loop)` already exists; this only grows what an existing field can
// hold, same shape as T3.1's `ffi_bridge`).
range_expr: "range" "(" value "," value ")"
// [e1, e2, ...] / name[index] — additive Value kinds (T8.13), same "not a new kernel node"
// shape as range_expr; memory-ref (D50/D60) stays the frozen kernel node, these only declare
// what an array holds and how one element is read back.
array_literal: "[" [value ("," value)*] "]"
index_expr: NAME "[" value "]"
// { f1 = v1, f2 = v2, ... } / name.field — additive Value kinds (G3), same "not a new kernel
// node" shape as array_literal/index_expr; field order in the literal IS the field's ordinal
// (its real byte offset, resolved by the closed tree before compile_goal runs, same contract
// array_addresses already has).
record_literal: "{" [NAME "=" value ("," NAME "=" value)*] "}"
field_expr: NAME "." NAME
// list[e1, e2, ...] / map{k1 = v1, ...} (G5) -- additive Value kinds, same "not a new kernel
// node" shape as array_literal/record_literal. `name[index]`/`name.field` (index_expr/field_expr
// above) are REUSED for reading a list/map -- which structure a name is is a semantic fact
// (resolved by Kollan at compile time, not the grammar), same as how those two rules already
// serve both plain and verified record reads without a syntax split.
list_literal: "list" "[" [value ("," value)*] "]"
map_literal: "map" "{" [NAME "=" value ("," NAME "=" value)*] "}"
// is_ok(bind) / payload(bind) — read the tag/value out of a fallible Bind's packed result
// (T8.16), same "additive Value kind" shape as everything else in this list.
is_ok_expr: "is_ok" "(" NAME ")"
payload_expr: "payload" "(" NAME ")"
// cycles() — N4, a NATIVE (not FFI) reading of the CPU's own cycle counter (x86-64 `rdtsc`,
// no syscall, no capability_addresses resolution -- a single instruction, the same "raw, no
// libc shim" philosophy D72's syscall-FFI already established for G2). Same "additive Value
// kind, not a new kernel node" shape as everything else in this list -- `memory-ref` (D50/D60)
// stays frozen; this only adds what a `remember`'s value can be.
cycles_expr: "cycles" "(" ")"
atom: NAME | STRING | NUMBER

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
OP: ">=" | "<=" | "==" | "!=" | ">" | "<"
STRING: /"[^"]*"/
NUMBER: /[0-9]+/

%import common.WS
%ignore WS
