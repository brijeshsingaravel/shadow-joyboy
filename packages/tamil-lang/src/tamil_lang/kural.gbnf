## Kural — the .tamil kernel grammar, GBNF mirror (RFC-0002 §6.4/§9, D12, T4).
## Hand-maintained mirror of kural.lark for llama.cpp/llama-cpp-python constrained decoding.
## Not auto-generated yet (T4 scope: prove the mechanism against the small, stable base-6
## grammar first — an automated Lark->GBNF converter is a later improvement once the
## grammar/genome, §3.5, is large enough to make hand-mirroring costly).

## T4's proof harness asks for one goal per generation; a real multi-goal `.tamil` file just
## swaps this back to `goal+` (mirroring kural.lark's `start: goal+`) -- kept single here so a
## token-budget cutoff mid-second-goal can never masquerade as a grammar bug.
root ::= goal

## No trailing ws after block: ws is zero-or-more, so a trailing slot lets a model ride it to
## max_tokens emitting blank lines -- still grammar-valid, just wasteful (a real T4 finding, s55).
goal ::= "goal" ws string ws block

block ::= "{" ws statement* "}"

statement ::= (call | ffi-call | govern | bind | remember | branch | loop) ws

call ::= "call" ws name ws "(" ws arglist? ws ")"
ffi-call ::= "ffi" ws "python" ws name ws "(" ws arglist? ws ")"
govern ::= "govern" ws name ws op ws value
bind ::= "bind" ws name ws "=" ws (call | ffi-call)
remember ::= "remember" ws name ws "=" ws value
branch ::= "if" ws value ws op ws value ws block (ws "else" ws block)?
loop ::= "for" ws name ws "in" ws name ws block

arglist ::= value (ws "," ws value)*
value ::= atom | recall
recall ::= "recall" ws "(" ws name ws ")"
atom ::= name | string | number

name ::= [a-zA-Z_][a-zA-Z0-9_]*
op ::= ">=" | "<=" | "==" | "!=" | ">" | "<"
string ::= "\"" [^"]* "\""
number ::= [0-9]+
ws ::= [ \t\n]*
