# Copy this file to `.env` and fill it in. `.env` is gitignored; never commit it.
# Variable NAMES only in this file — no values, ever.

# ── The model ────────────────────────────────────────────────────────────────
# "ollama" runs a model on your own machine and nothing you type leaves it.
# This is the default, and it is the configuration the hosted Shadow runs on.
MADRAS_LLM_BACKEND=ollama
MADRAS_OLLAMA_URL=http://127.0.0.1:11434

# Only needed if you set MADRAS_LLM_BACKEND=openrouter. Leave blank to stay local.
MADRAS_OPENROUTER_API_KEY=

# ── Memory ───────────────────────────────────────────────────────────────────
# Where the remembering actually lives. `docker compose up -d` starts both.
# Use 127.0.0.1 rather than localhost: on Windows, localhost resolves to ::1
# first, and an IPv4-bound service refuses the connection while looking healthy.
MADRAS_POSTGRES_URL=postgresql://madras:madras@127.0.0.1:5433/madras
MADRAS_QDRANT_URL=http://127.0.0.1:6335
MADRAS_QDRANT_API_KEY=
MADRAS_REDIS_URL=redis://127.0.0.1:6380/9

# The embedding model used for semantic recall — "what did I say about my
# sister's wedding" finding a conversation that said "the function in December".
MADRAS_EMBED_MODEL=nomic-embed-text

# ── Optional ─────────────────────────────────────────────────────────────────
# Tracing. Leave blank and it degrades to a silent no-op; nothing is sent.
MADRAS_LANGFUSE_PUBLIC_KEY=
MADRAS_LANGFUSE_SECRET_KEY=
MADRAS_LANGFUSE_HOST=
